<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Precio libre en caja, producto por producto (vacío por defecto). -->
  <record id="product_template_form_view_precio_libre" model="ir.ui.view">
    <field name="name">product.template.form.precio.libre.pos</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='pos']/field[@name='to_weight']" position="after">
        <field name="yg_precio_libre_pos" widget="boolean_toggle"/>
      </xpath>
    </field>
  </record>
</odoo>
