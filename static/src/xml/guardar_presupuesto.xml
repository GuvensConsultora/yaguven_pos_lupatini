<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- «Guardar como presupuesto» junto a «Cotización/orden» de pos_sale (pedido de Anael, 04/11/2026). -->
    <t t-name="yaguven_pos_lupatini.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']" position="before">
            <t t-call="point_of_sale.controlButton"
                t-if="this.pos.accessRight.canAccessQuotation"
                icon="'save'"
                btnText="'Guardar como presupuesto'"
                btnClasses="'btn-secondary '"
                onClick="() => this.onClickGuardarPresupuesto()"
                disabled="this.pos.disableForSelfOrder">
            </t>
        </xpath>
    </t>
</templates>
