<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ProductList" t-inherit-mode="extension">

        <!-- Barra de controles: toggle lista/tarjeta + botones de tamaño -->
        <xpath expr="//div[hasclass('product-list')]" position="before">
            <div class="lupatini-view-bar">
                <button class="lupatini-btn-view"
                        t-on-click="lupatiniToggleMode"
                        t-att-title="lupatiniIsCard ? 'Ver como lista' : 'Ver como tarjetas'">
                    <i t-if="lupatiniIsCard" class="fa fa-list-ul"/>
                    <i t-else="" class="fa fa-th-large"/>
                </button>
                <t t-if="lupatiniIsCard">
                    <button class="lupatini-btn-size"
                            t-on-click="lupatiniSizeDown"
                            title="Tarjetas más chicas"
                            t-att-disabled="lupatiniIsMinSize">−</button>
                    <button class="lupatini-btn-size"
                            t-on-click="lupatiniSizeUp"
                            title="Tarjetas más grandes"
                            t-att-disabled="lupatiniIsMaxSize">+</button>
                </t>
            </div>
        </xpath>

        <!-- CSS variable de tamaño + clase de modo lista sobre el grid -->
        <xpath expr="//div[hasclass('product-list')]" position="attributes">
            <attribute name="t-att-class">{"lupatini-list-mode": !lupatiniIsCard}</attribute>
            <attribute name="t-att-style">"--lupatini-card-w: " + lupatiniCardWidth</attribute>
        </xpath>

    </t>
</templates>
