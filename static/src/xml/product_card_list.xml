<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <!-- Precio y cantidad disponible debajo del nombre, en ambos modos -->
        <xpath expr="//div[hasclass('product-name')]" position="after">
            <div class="lupatini-card-info">
                <span class="lupatini-price" t-out="this.lupatiniPrice"/>
                <span class="lupatini-qty">
                    <i class="oi me-1" data-icon="inventory_2"/>
                    <t t-out="this.lupatiniQty"/>
                </span>
            </div>
        </xpath>
    </t>
</templates>
